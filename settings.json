{
  "version": 2,
  "active": true,
  "skip_menu": false,
  "defaults": {
    "only_extensions": [],
    "skip_folders": [
      "node_modules",
      "dist",
      "build",
      "out",
      "__pycache__",
      "venv",
      ".venv",
      ".git",
      ".dart_tool",
      ".idea"
    ],
    "skip_files": [
      "*.log",
      "*.tmp",
      ".env*"
    ],
    "skip_if_contains": [
      ".freezed.dart",
      ".g.dart",
      ".gr.dart",
      ".mocks.dart",
      "generated"
    ],
    "max_file_mb": 10,
    "include_hidden": false,
    "use_gitignore": true,
    "show_tree": true,
    "show_token_estimate": true,
    "sort_by": "path",
    "split_tokens": 0,
    "copy_to_clipboard": false,
    "output_dir": ".",
    "backup": {
      "keep": true,
      "compress": false,
      "days": 30
    }
  },
  "projects": []
}
